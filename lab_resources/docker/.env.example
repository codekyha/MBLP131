# Settings for docker-compose.yml. "docker compose" reads the file named .env next to the compose file;
# in the VM the installer has already created ~/labstack/.env from this file.
# These values are for a closed lab network only - change them for anything else.

JUPYTER_TOKEN=mbbo205
POSTGRES_USER=mbbo
POSTGRES_PASSWORD=mbbo205
POSTGRES_DB=mbbo205

# Host ports of the containers. The defaults are the standard ports. On a machine that has PostgreSQL / Redis as
# system services (the LabVM image, the WSL "Ubuntu Lab") the installer sets POSTGRES_PORT=15432 and REDIS_PORT=16379,
# because a container cannot publish a port that a service already uses on the same machine.
#POSTGRES_PORT=5432
#REDIS_PORT=6379
#NGINX_PORT=8080

# Group id of the "docker" group on this host (the lab container gets access to the Docker socket through it):
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# Build context of the lab container = the kit folder that contains lab_install.sh.
# (docker/ is a subfolder of the kit, hence ".."; in the VM the installer sets this to /opt/lab.)
LAB_KIT_DIR=..
